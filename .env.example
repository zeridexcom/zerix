# Server
PORT=3000

# Your Google Business review URL
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_REVIEW_LINK/review
BUSINESS_NAME=Your Business Name

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# WhatsApp Option 1: OpenWA (Free & Open Source Self-Hosted - NO Business API Needed!)
# GitHub: https://github.com/rmyndharis/OpenWA
# Just run: docker run -d -p 2785:2785 rmyndharis/openwa
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_your_openwa_api_key_here
OPENWA_SESSION_ID=your_openwa_session_uuid

# WhatsApp Option 2: Twilio WhatsApp
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=+14155238886

# WhatsApp Option 3: Meta Cloud API (Official)
# WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# Follow-up settings
FOLLOW_UP_DAYS=3

